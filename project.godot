; Engine configuration file.
; 灵契·星塔远征 — original lightweight roguelike tower climber.
config_version=5

[application]

config/name="灵契·星塔远征"
config/description="怀旧肉鸽爬塔单机版：50 只可进化精灵、5 上阵、10 层星塔、宝箱与技能词条。"
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

ContentDB="*res://scripts/autoload/content_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
UI="*res://scripts/autoload/ui.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/resizable=true

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.075, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[audio]

driver/enable_input=false
